# Copiar a .env y completar. El .env real nunca se commitea.
PORT=3001
DATABASE_PATH=data/app.db

# Generar un secreto propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Producción: ruta al build del cliente para que Express lo sirva
# (relativa al directorio server/). En desarrollo dejar vacío: Vite se encarga.
# CLIENT_DIST=../client/dist
